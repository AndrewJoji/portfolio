# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — never commit real secrets.

# ElevenLabs API key, used only by scripts/*.mts (local audio generation).
# Get it from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Run `npm run voices` after setting the key above to list your available
# voices and their IDs, then paste the one you want here.
ELEVENLABS_VOICE_ID=
